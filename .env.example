# Copy this file to .env and enter local values. Never upload or commit .env.
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost/floodguard

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=floodguard_db
DB_USER=root
DB_PASSWORD=

FLOODGUARD_DEVICE_ID=FG-STATION-001
FLOODGUARD_DEVICE_API_KEY=replace-with-a-long-random-secret

# Phase 12 requires X-Device-ID and X-Device-Key on every telemetry request.
FG_DEVICE_LEGACY_CREDENTIALS=false
FG_TELEMETRY_COMPAT_MODE=false
FG_STORE_RAW_TELEMETRY=false
FG_LEGACY_SMS_ENABLED=false

# Resident account email verification (PHPMailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=FloodGuard
